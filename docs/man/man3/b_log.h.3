    if (baseer_log_level() >= BASEER_LOG_INFO) \\
        printf("\\033[34m[INFO]\\033[0m  " fmt "\\n", ##__VA_ARGS__); \\
} while(0)
.PP
.fi

.SS "#define LOG_WARN( fmt,  \&.\&.\&.)"
\fBValue:\fP
.nf
